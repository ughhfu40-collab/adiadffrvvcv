    "sentences": [
      {
        "id": "s1",
        "text": "Ақсу ауылының балалары аудан орталығындағы мектепке қырық шақырым жол жүреді."
      },
      {
        "id": "s2",
        "text": "Мектеп автобусы таңертең сағат жетіде ауылдан шығады."
      },
      {
        "id": "s3",
        "text": "Былтыр қыста жол жиі жабылып, автобус аптасына екі-үш рет келмей қалатын."
      },
      {
        "id": "s4",
        "text": "Сол күндері оқушылар сабақты телефон арқылы оқытушыдан тапсырма алып орындайтын."
      },
      {
        "id": "s5",
        "text": "Биыл жол жөнделіп, оның бойына қар тоқтататын қалқандар орнатылды."
      },
      {
        "id": "s6",
        "text": "Содан бері автобус бір де бір рет кешікпеді."
      },
      {
        "id": "s7",
        "text": "Сынып жетекшісі оқушылардың үлгерімі айтарлықтай жақсарғанын айтады."
      }
