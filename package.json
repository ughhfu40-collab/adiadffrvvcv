{
  "name": "oqy-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:check": "tsx scripts/ollama-check.ts",
    "student-agent": "node scripts/student-agent.mjs",
    "rubric": "tsx scripts/rubric-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "workbox-window": "^7.4.1"
  }
